# KwakoPOS SaaS — Environment Configuration Template
# Server Database Connection URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/kwakopos

# Server Authentication & Session Secrets
JWT_SECRET=your_cryptographically_secure_jwt_secret_min_32_chars
SESSION_SECRET=your_cryptographically_secure_session_secret_min_32_chars
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600

# Environment Mode (development | production | staging | test)
APP_ENV=development
NODE_ENV=development

# Server Port
PORT=8080

# Frontend API Endpoint
VITE_API_URL=http://localhost:8080

